{
  "name": "pembukuan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun ./build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && bun --env-file=../.env test tests/unit tests/integration",
    "test:unit": "svelte-kit sync && bun --env-file=../.env test tests/unit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env run src/lib/server/db/migrate.ts",
    "db:seed": "bun --env-file=../.env run seeds/index.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "better-auth": "1.7.6",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.2",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.55.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/pdfkit": "0.17.6",
    "bits-ui": "2.19.5",
    "cn": "0.3.3",
    "drizzle-kit": "0.31.11",
    "pdf-parse": "2.4.5",
    "shadcn-svelte": "1.7.0",
    "svelte": "5.57.1",
    "svelte-adapter-bun": "1.0.1",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
