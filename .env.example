# Satu-satunya file env (docker compose dan pengembangan lokal). Salin ke .env lalu isi nilainya.
# File .env tidak boleh di-commit. Skrip di app/ membacanya lewat `bun --env-file=../.env`.
POSTGRES_PASSWORD=ganti-password-db
BETTER_AUTH_SECRET=isi-dengan-hasil-openssl-rand-hex-32
APP_ORIGIN=http://localhost:3000
OLLAMA_MODEL=qwen2.5:7b
SEED_ADMIN_EMAIL=admin@pembukuan.local
SEED_ADMIN_PASSWORD=ganti-password-admin

# Hanya untuk pengembangan lokal (bun run dev / test); docker compose mengisi nilainya sendiri.
DATABASE_URL=postgres://pembukuan:pembukuan@localhost:5432/pembukuan
BETTER_AUTH_URL=http://localhost:5173
SIDECAR_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
